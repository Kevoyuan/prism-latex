{
  "name": "prism-latex",
  "version": "0.2.0",
  "type": "module",
  "description": "Renders generated .tex files as compiled documents in the DeepSeek Harness sidebar preview.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kevoyuan/prism-latex.git"
  },
  "homepage": "https://github.com/Kevoyuan/prism-latex#readme",
  "bugs": {
    "url": "https://github.com/Kevoyuan/prism-latex/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "latex",
    "tex",
    "bundle",
    "preview"
  ],
  "exports": {
    ".": "./src/host.js",
    "./client": "./src/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README_CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ]
    }
  }
}
